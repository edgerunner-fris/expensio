# ---------------------------------------------------------------------------
# Expensio 本地开发配置模板。复制为 .env 后使用（make env）。
# `make env` 会把口令类值替换成随机十六进制串，不要直接把本文件当 .env 用。
# 这里全部是本地占位值；生产环境从 K8s Secret 注入，禁止提交真实凭据。
#
# 变量分两类：
#   1) 应用读取的配置 —— 一律 EXPENSIO_ 前缀，由 internal/platform/config 解析；
#   2) 容器初始化参数 —— 由 docker compose 读取（POSTGRES_*、MINIO_ROOT_*），
#      应用不读，改这里不会影响服务行为。
# 两类不要混用，否则会出现"改了 .env 服务没反应"的困惑。
# ---------------------------------------------------------------------------

EXPENSIO_ENV=local
EXPENSIO_LOG_LEVEL=debug

# --- 应用：数据库（六个库共用同一实例，库名按服务区分） -----------------------
# 库名由 compose 按服务单独注入，这里不设 EXPENSIO_DB_NAME。
# 运行时账号是 {service}_app（NOBYPASSRLS），迁移账号是 {service}_migrator。
# 下面的口令只是模板占位；make env 会生成 .env 并替换为随机十六进制值。
EXPENSIO_DB_HOST=localhost
EXPENSIO_DB_PORT=5432
EXPENSIO_DB_USER=identity_app
EXPENSIO_DB_PASSWORD=expensio_local_only
EXPENSIO_DB_SSLMODE=disable
EXPENSIO_DB_MAX_CONNS=10

# 完整覆盖（需要连连接串特殊参数时才用）：
# EXPENSIO_DB_DSN=postgres://identity_app:expensio_local_only@localhost:5432/identity_db?sslmode=disable

# --- 应用：Redis -----------------------------------------------------------
EXPENSIO_REDIS_ADDR=localhost:6379
EXPENSIO_REDIS_PASSWORD=
EXPENSIO_REDIS_DB=0

# --- 应用：Kafka（宿主端口 29092，容器内 9092） ------------------------------
EXPENSIO_KAFKA_BROKERS=localhost:29092

# --- 应用：JWT -------------------------------------------------------------
# 只支持 EdDSA（Ed25519）。不存在 HS256 共享密钥：
# 验签服务只挂公钥，即使被攻破也无法伪造令牌。
EXPENSIO_JWT_ISSUER=expensio
EXPENSIO_JWT_ACCESS_TTL=15m
EXPENSIO_JWT_REFRESH_TTL=168h
# Ed25519 密钥（base64）。make env 会用 openssl 生成并写入；
# 私钥只注入 identity，公钥注入所有需要验签的服务。
# 多个公钥用逗号分隔，用于轮换期同时接受新旧 kid。
EXPENSIO_JWT_PRIVATE_KEY=
EXPENSIO_JWT_PUBLIC_KEYS=

# --- 应用：MinIO（票据与发票附件） ------------------------------------------
EXPENSIO_MINIO_ENDPOINT=localhost:9000
# 浏览器访问对象存储的地址，只影响 presigned URL 的 Host。
# 本机直跑与 compose 都指向宿主端口；留空表示与 ENDPOINT 相同。
EXPENSIO_MINIO_PUBLIC_ENDPOINT=localhost:9000
EXPENSIO_MINIO_ACCESS_KEY=expensio
EXPENSIO_MINIO_SECRET_KEY=expensio_local_only
EXPENSIO_MINIO_BUCKET=expensio-invoices
EXPENSIO_MINIO_USE_SSL=false

# --- 应用：Billing 支付回调 -------------------------------------------------
# HMAC-SHA256 密钥，至少 32 字节；本地值仅用于开发，生产必须来自 Secret。
EXPENSIO_BILLING_WEBHOOK_PROVIDER=mockpay
EXPENSIO_BILLING_WEBHOOK_SECRET=local-only-billing-webhook-secret-32b

# --- 应用：内部通知（identity / notification 共用） -------------------------
# 服务间令牌：至少 32 字节，identity 与 notification 必须配置成同一个值。
# 它只用于 /api/v1/internal/*，与用户 JWT 密钥分开；生产从 Secret 注入。
EXPENSIO_NOTIFICATION_INTERNAL_TOKEN=local-only-internal-token-at-least-32
EXPENSIO_NOTIFICATION_IDENTITY_URL=http://127.0.0.1:8081
# identity 用它投递邀请邮件；与上面两个键必须指向同一套服务。
EXPENSIO_NOTIFICATION_SERVICE_URL=http://127.0.0.1:8085
EXPENSIO_NOTIFICATION_EMAIL_ENABLED=true
# 本地 Mailpit：SMTP 1025，网页收件箱 http://127.0.0.1:8025
EXPENSIO_NOTIFICATION_SMTP_ADDR=localhost:1025
EXPENSIO_NOTIFICATION_SMTP_FROM=no-reply@expensio.local
EXPENSIO_NOTIFICATION_SMTP_USERNAME=
EXPENSIO_NOTIFICATION_SMTP_PASSWORD=
# 生产 SMTP 应设为 true：服务器不支持 STARTTLS 时拒绝发送。
EXPENSIO_NOTIFICATION_SMTP_USE_TLS=false

# --- 应用：成员邀请 --------------------------------------------------------
# 邀请链接前缀必须与用户实际访问的站点一致；本地 compose 把 web 发布到 5173。
EXPENSIO_INVITE_BASE_URL=http://localhost:5173
EXPENSIO_INVITE_TTL=168h

# --- 应用：OpenTelemetry ---------------------------------------------------
EXPENSIO_OTEL_ENDPOINT=localhost:4317
EXPENSIO_OTEL_INSECURE=true

# --- 容器初始化（仅 docker compose 读取） ----------------------------------
POSTGRES_USER=expensio
POSTGRES_PASSWORD=expensio_local_only
# 初始化脚本据此创建 {service}_app / {service}_migrator 两个角色。
# 口令会拼进迁移连接串，只允许 URL 安全字符。
EXPENSIO_DB_APP_PASSWORD=expensio_local_only
EXPENSIO_DB_MIGRATOR_PASSWORD=expensio_local_only
MINIO_ROOT_USER=expensio
MINIO_ROOT_PASSWORD=expensio_local_only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_local_only
